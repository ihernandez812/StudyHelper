{
  "name": "study_helper",
  "version": "1.1.1",
  "main": "src/main/index.js",
  "description": "Study Helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihernandez812/StudyHelper"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder -m",
    "deploy": "GH_TOKEN=$(gh auth token) electron-builder build -m --publish always && gh release edit v$npm_package_version --draft=false --latest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "npx tsc --noEmit --strict false"
  },
  "author": "Isaiah Hernandez",
  "license": "ISC",
  "productName": "Study Helper",
  "homepage": "https://github.com/ihernandez812/StudyHelper",
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "bootstrap": "^5.3.8",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3"
  },
  "build": {
    "appId": "com.ih.StudyHelper",
    "copyright": "Big Dog Inc.",
    "files": [
      "!src/private/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "ihernandez812",
      "repo": "StudyHelper"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "src/renderer/images/AnatoMeIcon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    }
  }
}
